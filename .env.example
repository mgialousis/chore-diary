NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/today
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Runtime app connection. For Supabase on Vercel/serverless, use the transaction
# pooler URL on port 6543 with PgBouncer mode enabled for Prisma.
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Direct CLI connection for Prisma migrate/seed/studio.
DIRECT_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Optional seed-only values for demo data
SEED_DEMO_CLERK_ID=
SEED_DEMO_EMAIL=
SEED_DEMO_NAME=Demo User
SEED_DEMO_HOUSEHOLD=Demo Household
